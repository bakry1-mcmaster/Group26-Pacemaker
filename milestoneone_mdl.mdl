<?xml version="1.0" encoding="utf-8"?>
<chart id="137">
  <P Name="name">AAI</P>
  <P Name="windowPosition">[-1 -7 1281 680]</P>
  <P Name="viewLimits">[-118.459 1387.097 -281.221 476.557]</P>
  <P Name="zoomFactor">2.222</P>
  <P Name="screen">[1 1 3200 1200 1.25]</P>
  <P Name="viewObj">137</P>
  <P Name="ssIdHighWaterMark">67</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="chartFileNumber">4</P>
  <P Name="allowGlobalAccessToExportedFunctions">0</P>
  <P Name="saturateOnIntegerOverflow">1</P>
  <P Name="userSpecifiedStateTransitionExecutionOrder">1</P>
  <P Name="disableImplicitCasting">1</P>
  <P Name="actionLanguage">2</P>
  <Children>
    <state SSID="2">
      <P Name="labelString">PACING

entry:
state_out = &quot;AAI PACING&quot;
AP = true; % deliver pacing pulse
In_ARP = false;
timer = 0;
during:
timer = timer + 1;
if (timer &gt;= p_aPaceWidth)
    % Pulse width elapsed -&gt; stop pacing
    AP = false;
    % -&gt; Refractory
end</P>
      <P Name="position">[794.6 69.4667 237.7778 224]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">137</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <Children>
        <data SSID="58" name="data">
          <P Name="scope">LOCAL_DATA</P>
          <props>
            <array>
              <P Name="size">-1</P>
            </array>
            <type>
              <P Name="method">SF_INHERITED_TYPE</P>
              <P Name="primitive">SF_DOUBLE_TYPE</P>
              <P Name="isSigned">1</P>
              <P Name="wordLength">16</P>
            </type>
            <P Name="frame">SF_FRAME_INHERITED</P>
            <unit>
              <P Name="name">inherit</P>
            </unit>
          </props>
          <P Name="dataType">Inherit: From definition in chart</P>
        </data>
      </Children>
    </state>
    <state SSID="23">
      <P Name="labelString">WAIT

entry:
state_out = &quot;AAI WAIT&quot;;
AP = false;
In_ARP = false;
timer = 0;
during:
if (AS &amp;&amp; ~In_ARP)
    % Detected intrinsic atrial beat before timeout
    timer = 0;
    %transition_to(Refractory);
    % ^ Causes an error, add back in later
elseif (timer &gt;= p_lowRateInterval)
    %Timeout -&gt; no intrinsic beat, deliver pulse
    % -&gt;Pacing
end</P>
      <P Name="position">[436.5705 271.6648 279.9 239.8333]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">137</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <Children>
        <data SSID="57" name="data">
          <P Name="scope">LOCAL_DATA</P>
          <props>
            <array>
              <P Name="size">-1</P>
            </array>
            <type>
              <P Name="method">SF_INHERITED_TYPE</P>
              <P Name="primitive">SF_DOUBLE_TYPE</P>
              <P Name="isSigned">1</P>
              <P Name="wordLength">16</P>
            </type>
            <P Name="frame">SF_FRAME_INHERITED</P>
            <unit>
              <P Name="name">inherit</P>
            </unit>
          </props>
          <P Name="dataType">Inherit: From definition in chart</P>
        </data>
      </Children>
    </state>
    <state SSID="62">
      <P Name="labelString">INACTIVE</P>
      <P Name="position">[182.4254 313.0087 90 60]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">137</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="9">
      <P Name="labelString">Refractory

entry:
    state_out = &quot;AAI REFRACTORY&quot;
    In_ARP = true;
    AP = false;
    timer = 0;
during:
    timer = timer + 1;
    % Ignore all AS during ARP
    if (timer &gt;= ARP)
        In_ARP = false;
        timer = 0;
        % -&gt; Waiting
    end</P>
      <P Name="position">[1077.0223 336.0648 182.6666 217.3333]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">137</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <data SSID="16" name="p_aPaceWidth">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <P Name="initialValue">0.4</P>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">double</P>
    </data>
    <data SSID="21" name="p_lowRateInterval">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <P Name="initialValue">6000/low_rate_lim</P>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="primitive">SF_UINT16_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">uint16</P>
    </data>
    <data SSID="47" name="AP">
      <P Name="scope">LOCAL_DATA</P>
      <props>
        <P Name="initialValue">false</P>
        <array>
          <P Name="size">-1</P>
