      <P Name="position">[163.816 177.7509 21.3281 16]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">GROUPED</P>
      <P Name="isNoteBox">1</P>
      <P Name="subviewer">98</P>
      <P Name="type">GROUP_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="9">
      <P Name="labelString">REFRACTORY

entry:
current_state = &quot;VVI REFRACTORY&quot;
% Stop generating pace
p_outputAmp = 0;
% Wait for a refractory period
f_waitInterval = p_VRP + p_hysterisis*p_hysterisisInterval;
if ~p_rateSmoothing == 0
    % Apply rate smoothing if enabled
    delta = f_waitInterval - prevInterval;
    maxDelta = (p_rateSmoothing / 100) * prevInterval; %Percent Rate Smoothing
    if abs(delta) &gt; maxDelta
        delta = maxDelta;
    end
    nextInterval = prevInterval + delta;
    prevInterval = nextInterval;
end
PACE_CHARGE_CTRL = 1;</P>
      <P Name="position">[796.9439 179.3971 451.5444 298.4444]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">98</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="47">
      <P Name="labelString">Stateflow cycles in INACTIVE when not selected</P>
      <P Name="position">[32.6482 319.3766 259.25 16]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">GROUPED</P>
      <P Name="isNoteBox">1</P>
      <P Name="subviewer">98</P>
      <P Name="type">GROUP_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="23">
      <P Name="labelString">SENSING

entry:
current_state = &quot;VVI SENSING&quot;
if ~isInitialized
    prevInterval = p_lowRateInterval;
    nextInterval = p_lowRateInterval;
    isInitialized = true;
    VENT_CMP_DETECT = 1;
end
PACE_CHARGE_CTRL = 0;
% If the input signal is higher than the
% sensitivity threshold, wait for another
% refractory period
% If the low rate interval passes and no
% signals higher than the threshold are
% detected, send another pace</P>
      <P Name="position">[366.9901 337.0388 250.5405 261.6886]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">98</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
