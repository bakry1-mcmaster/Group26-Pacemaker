<chart id="133">
  <P Name="name">AOO</P>
  <P Name="windowPosition">[199.5 216.75 417 348.75]</P>
  <P Name="viewLimits">[126.81 869.31 50.906 619.239]</P>
  <P Name="zoomFactor">1.667</P>
  <P Name="screen">[1 1 3200 1200 1.25]</P>
  <P Name="viewObj">133</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">38</P>
