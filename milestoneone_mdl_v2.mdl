  <P Name="chartFileNumber">2</P>
  <P Name="allowGlobalAccessToExportedFunctions">0</P>
  <P Name="saturateOnIntegerOverflow">1</P>
  <P Name="userSpecifiedStateTransitionExecutionOrder">1</P>
  <P Name="disableImplicitCasting">1</P>
  <P Name="actionLanguage">2</P>
  <Children>
    <state SSID="36">
      <P Name="labelString">Max total cycle time - time already elapsed this cycle</P>
      <P Name="position">[486.0659 80.8994 281.1875 16]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">GROUPED</P>
      <P Name="isNoteBox">1</P>
      <P Name="subviewer">133</P>
      <P Name="type">GROUP_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="37">
      <P Name="labelString">AOO Pacing Mode</P>
      <P Name="position">[107.1548 114.0404 101.9844 16]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">GROUPED</P>
      <P Name="isNoteBox">1</P>
      <P Name="subviewer">133</P>
      <P Name="type">GROUP_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="35">
      <P Name="labelString">Cycle through this state when AoO isn&apos;t selected</P>
      <P Name="position">[32.8723 183.5661 258.2344 16]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">GROUPED</P>
      <P Name="isNoteBox">1</P>
      <P Name="subviewer">133</P>
      <P Name="type">GROUP_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="9">
      <P Name="labelString">PACE

entry:
%Send out pace signal
p_outputAmp = p_aPaceAmp;
current_state = &quot;AOO PACE&quot;
PACE_CHARGE_CTRL = 0;
% Wait for the width of a pace
</P>
      <P Name="position">[648.6667 191.7334 173.3333 114]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">133</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="2">
      <P Name="labelString">CHARGE

entry:
% Stop pacing, wait rest of cycle time
p_outputAmp = 0;
current_state = &quot;AOO CHARGE&quot;
PACE_CHARGE_CTRL = 1;
</P>
      <P Name="position">[387.9333 194.4 214 108.6668]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">133</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <Children>
        <data SSID="25" name="data">
          <P Name="scope">LOCAL_DATA</P>
          <props>
