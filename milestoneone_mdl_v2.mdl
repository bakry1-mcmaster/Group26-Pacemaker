  <Children>
    <state SSID="70">
      <P Name="labelString">PACING

entry:
state_out = &quot;AAI PACING&quot;
p_outputAmp = p_aPaceAmp;
end</P>
      <P Name="position">[632.5475 618.0332 237.7778 224]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">176</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="72">
      <P Name="labelString">WAIT

entry:
state_out = &quot;AAI SENSING&quot;
entry:
    if ~isInitialized
        prevInterval = p_lowRateInterval;
        nextInterval = p_lowRateInterval;
        isInitialized = true;
        ATR_CMP_DETECT = 0;
    end
    PACE_CHARGE_CTRL = 0;</P>
      <P Name="position">[284.518 804.898 279.9 239.8333]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">176</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="68">
      <P Name="labelString">INACTIVE</P>
      <P Name="position">[20.3729 861.5752 90 60]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">176</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
    </state>
    <state SSID="73">
      <P Name="labelString">REFRACTORY

entry:
    state_out = &quot;AAI REFRACTORY&quot;
    f_waitInterval = p_ARP + p_hysterisis*p_hysterisisInterval;
    % Apply rate smoothing if enabled
    if ~p_rateSmoothing == 0
        delta = f_waitInterval - prevInterval;
        maxDelta = (p_rateSmoothing / 100) * prevInterval; %Percent Rate Smoothing
        if abs(delta) &gt; maxDelta
            delta = maxDelta;
        end
        nextInterval = prevInterval + delta;
        prevInterval = nextInterval;
    end
    PACE_CHARGE_CTRL = 1;</P>
      <P Name="position">[914.9698 884.6313 450.2731 334.4]</P>
      <P Name="fontSize">12</P>
