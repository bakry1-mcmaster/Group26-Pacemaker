              <P Name="name">inherit</P>
            </unit>
          </props>
          <P Name="dataType">Inherit: From definition in chart</P>
        </data>
      </Children>
    </state>
    <state SSID="28">
      <P Name="labelString">INACTIVE

% When state is not selected by input</P>
      <P Name="position">[20.5289 212.3026 220.6667 72.8615]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">133</P>
